{
  "name": "lostfound-backend",
  "version": "0.0.1",
  "description": "Lost & Found backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:migrate": "npm run build && typeorm -d dist/database/data-source.js migration:run",
    "db:revert": "npm run build && typeorm -d dist/database/data-source.js migration:revert",
    "db:show": "npm run build && typeorm -d dist/database/data-source.js migration:show",
    "verify:cu1": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-cu1.ps1",
    "verify:cu2": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-cu2.ps1",
    "verify:cu3": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-cu3.ps1",
    "verify:cu4": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-cu4.ps1",
    "verify:cu5": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-cu3.ps1",
    "verify:cu6": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-cu6.ps1",
    "verify:cu7": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-cu7.ps1",
    "matches:backfill": "npm run build && node dist/commands/backfill-publication-matches.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  }
}
